# Local database (npm run db:up starts it in Docker).
DATABASE_URL=postgres://guardian:guardian@localhost:5432/achrona
# AI provider: cli (default, uses the logged-in `claude` CLI with Haiku, no API key),
# api (Anthropic SDK, needs ANTHROPIC_API_KEY) or off (offline keyword heuristics only).
AI_PROVIDER=cli
# Optional overrides.
AI_MODEL=
CLAUDE_BIN=
ANTHROPIC_API_KEY=
